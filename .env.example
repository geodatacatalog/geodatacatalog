# GeoDataCatalog — environment variables referenced by catalog.yml (${VAR} syntax).
# Copy this file to `.env`, fill in your keys, then load it before running:
#
#   cp .env.example .env
#   set -a && source .env && set +a        # bash / zsh
#
# In a notebook or script:
#
#   from dotenv import load_dotenv         # pip install python-dotenv
#   load_dotenv()                          # before load_catalog()
#
# `.env` is gitignored — never commit real keys.

# --- Copernicus Data Space Ecosystem (Sentinel downloads) -------------------
# Free account → https://dataspace.copernicus.eu
# S3 credentials → https://eodata-s3keysmanager.dataspace.copernicus.eu
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# --- GEODES / CNES (THEIA products: OSO land cover, LAI) --------------------
# Free API key → https://geodes-portal.cnes.fr/MyInformation
GEODES_API_KEY=

# --- NASA Earthdata (LP DAAC / CMR: SRTM, NASADEM, ASTER GDEM...) -----------
# Free account → https://urs.earthdata.nasa.gov/users/new
# Generate a token (Earthdata Login → "Generate Token") → https://urs.earthdata.nasa.gov/profile
EARTHDATA_TOKEN=

# --- Copernicus Climate Data Store (ERA5 and other reanalysis, via cdsapi) --
# Free account → https://cds.climate.copernicus.eu
# API key (personal access token) → https://cds.climate.copernicus.eu/how-to-api
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Google Earth Engine (data access via the earthengine-api) ---------------
# Register (free for non-commercial use) + pick a Cloud project
# → https://code.earthengine.google.com/register
# Interactive use: run `earthengine authenticate` once (no env var needed).
# Server-side use: create a service account + JSON key
# → https://developers.google.com/earth-engine/guides/service_account
EARTHENGINE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- ACLED (geolocated conflict & protest events) ----------------------------
# Free registration → https://developer.acleddata.com/
ACLED_KEY=
ACLED_EMAIL=

# --- Mapillary (street-level imagery) ----------------------------------------
# Free token → https://www.mapillary.com/dashboard/developers
MLY_TOKEN=

# --- OpenCellID (cell-tower database) -----------------------------------------
# Free key → https://opencellid.org/register.php
OPENCELLID_KEY=
